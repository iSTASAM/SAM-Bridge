PUSH_API_KEY=
AUTH_USER=admin
AUTH_PASSWORD=

# Optional: overrides the GPT Actions key managed from /settings/gpt-actions
GPT_ACTION_API_KEY=

# Supabase — stores iXacs machine connections, Push API keys (/settings/push), and LINE webhook settings.
# Push event payloads stay local (andon-state) — not written to Supabase.
# Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AES key for customer ID / login ID / password at rest (DB + local file).
# Use a long random string. Falls back to AUTH_PASSWORD if unset (not recommended).
CONNECTIONS_ENCRYPTION_KEY=

# LINE Messaging API / LIFF (required on Vercel for webhook Verify)
# Messaging API → Channel secret
LINE_CHANNEL_SECRET=
# Required for per-user Rich Menu switching after /line login.
# May instead be saved securely in /settings/notifications/line-webhook.
LINE_CHANNEL_ACCESS_TOKEN=
# Rich Menu 2 shown after a successful iXacs login.
LINE_RICHMENU_LOGGED_IN=richmenu-ab29249ac133a6fa9f2b9393f9a82d95
# Optional: restore this default (login) rich menu on logout
# LINE_RICHMENU_LOGGED_OUT=richmenu-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides (also configurable in /settings/notifications/line-webhook)
LINE_PUBLIC_URL=https://sam-bridge.vercel.app
LINE_LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

# Bearer token for a scheduler calling GET /api/notifications/monitor every minute.
CRON_SECRET=

# Allow /line login + dashboard in a normal browser for UX review
# (auto-on in development; set to 1 on Vercel if needed)
LINE_ALLOW_WEB_PREVIEW=1

# Configure machine URL / login from /settings
